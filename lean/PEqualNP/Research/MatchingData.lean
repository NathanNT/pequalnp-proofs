import Mathlib
import PEqualNP.Defs

namespace PEqualNP.Research.MatchingData

abbrev I := Fin 4
abbrev Pos := I × I
abbrev N := Option (I × Fin 3)

def addr (p : I → I) (a : I × Fin 3) : Pos := (a.1,(p a.1).succAbove a.2)
def g (a : Pos) : ℤ := if a.1 = a.2 then 16 else 11
def h (a b : Pos) : ℤ :=
  if a.1 = b.1 ∨ a.2 = b.2 then 0 else
  if (a.1 = a.2 ∧ b.1 = b.2) ∨ (a.1 = b.2 ∧ b.1 = a.2) then 5 else
  if a.1 = a.2 ∨ a.1 = b.2 ∨ b.1 = a.2 ∨ b.1 = b.2 then 3 else 2

def gram (p : I → I) : Matrix N N ℤ := Matrix.of fun i j =>
  match i,j with
  | none,none => 0
  | none,some b => g (addr p b)
  | some a,none => g (addr p a)
  | some a,some b => h (addr p a) (addr p b)

def index : N → ℕ
  | none => 0
  | some (i,j) => 1+i.val*3+j.val

