def leftInvNum (p : I → I) : Matrix N N ℤ := Matrix.of fun i j =>
  let a := max (index i) (index j)
  let b := min (index i) (index j)
  (certData (p 0) (p 1) (p 2) (p 3)).1.getD (a*(a+1)/2+b) 0

